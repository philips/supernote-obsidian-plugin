# vscode
.vscode
.claude

# Intellij
*.iml
.idea

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# ...but examples/ plugins are hand-written source (no build step), not a
# build artifact — the "main.js" ignore rule above is unanchored and would
# otherwise silently swallow them too.
!examples/**/main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

node_modules/.package-lock.json
node_modules
.aider*
